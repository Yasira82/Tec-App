.env.test.local
.env.production.local

# Next.js build output
.next/
out/

# Dependencies
node_modules/

# Build outputs
dist/
# ANCHORED, for the same reason as /coverage/ below — and it had already
# happened again: `build/` unanchored swallowed the SOURCE route
# `src/app/api/admin/campaign/build/`. `git add -A` said nothing, and the file
# would have been missing from the deploy with no error anywhere. The
# tracked-files test is what caught it, which is the whole reason that test
# exists.
/build/
*.tsbuildinfo

# Playwright test results
test-results/
playwright-report/

# Coverage
# ANCHORED (leading slash). Unanchored, `coverage/` matches a directory of that
# name at ANY depth — which silently swallowed the API route
# `src/app/api/admin/pioneers/coverage/`. `git add -A` said nothing, the tests
# passed locally because the file was on disk, and CI failed on a file it had
# never been given. Only the build output at the package root is meant here.
/coverage/

