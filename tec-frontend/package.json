{
  "name": "@yasser172/tec-sdk",
  "version": "1.0.1",
  "description": "TEC SDK — The sovereign bridge between 24 Domains and TEC Core Platform",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc && tsc-alias",
    "lint": "eslint 'src/**/*.ts' --fix",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "audit:fix": "npm audit fix",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "zod": "^3.22.4",
    "pino": "^8.19.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.19",
    "@typescript-eslint/eslint-plugin": "^7.0.1",
    "@typescript-eslint/parser": "^7.0.1",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "pino-pretty": "^10.3.1",
    "ts-jest": "^29.1.2",
    "tsc-alias": "^1.8.8",
    "typescript": "^5.3.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yasser1728/TEC-SDK.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
